<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AndroidX SplashScreen theme: works on Android 8 (API 26) through Android 14+ -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KidLoop</item>
    </style>

    <style name="Theme.KidLoop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
